{
  "manifestVersion": 2,
  "id": "vaporview",
  "name": "Vaporview",
  "version": "0.1.0",
  "description": "Waveform viewer for VCD, FST, and GHW files. A port of the VS Code extension vaporview.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.js",
  "contributes": {
    "panels": [
      {
        "id": "waveforms",
        "title": "Vaporview",
        "icon": "activity",
        "entry": "panel.html",
        "ui": "html"
      }
    ],
    "customEditors": [
      {
        "id": "waveform",
        "title": "Vaporview",
        "extensions": [
          ".vaporview.json"
        ],
        "entry": "editor.html",
        "frame": "isolated"
      }
    ],
    "statusBarItems": [
      {
        "id": "vaporview-marker",
        "tooltip": "Vaporview: marker time"
      },
      {
        "id": "vaporview-delta",
        "tooltip": "Vaporview: time between the markers"
      },
      {
        "id": "vaporview-signal",
        "tooltip": "Vaporview: selected signal"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "settings": [
      {
        "key": "treeIcons",
        "title": "Netlist Icons",
        "type": "string",
        "enum": [
          "Orca",
          "Vaporview"
        ],
        "default": "Orca",
        "description": "The icons of the items in the netlist tree and in the search results. \"Orca\" uses the icon set of Orca in one color. \"Vaporview\" uses the icons and colors of vaporview in VS Code."
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "settings:own"
    }
  ]
}
